patch <- function(df, arabic, latin, lat_val, lon_val) {
df |> mutate(
lat       = ifelse(str_detect(coalesce(sector_en, ""), fixed(arabic)) & is.na(lat),
lat_val, lat),
lon       = ifelse(str_detect(coalesce(sector_en, ""), fixed(arabic)) & is.na(lon),
lon_val, lon),
sector_en = ifelse(str_detect(coalesce(sector_en, ""), fixed(arabic)),
latin, sector_en)
)
}
